# Windows (Rtools, GNU toolchain). Written to src/Makevars.win by
# tools/config.R, from configure.win. Pattern from rextendr's template.
TARGET = $(subst 64,x86_64,$(subst 32,i686,$(WIN)))-pc-windows-gnu
TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/@LIBDIR@
STATLIB = $(LIBDIR)/libtabularberg.a
# System libraries the Rust standard library, tokio, rustls/aws-lc and the
# platform certificate verifier link against on Windows.
PKG_LIBS = -L$(LIBDIR) -ltabularberg -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll \
	-lcrypt32 -lsecur32 -lncrypt -lole32 -loleaut32 -liphlpapi -lpsapi -lshell32 \
	-lsynchronization -luuid

all: $(SHLIB) rust_clean

.PHONY: $(STATLIB)

$(SHLIB): $(STATLIB)

CARGOTMP = $(CURDIR)/.cargo

# aws-lc (rustls' crypto, via aws-lc-sys) at the Windows 10 API level. Rtools'
# gcc defaults to _WIN32_WINNT=0x0601 (Windows 7), where aws-lc's
# CRYPTO_sysrand uses BCryptGenRandom; that fails in aws-lc's exit-time DRBG
# zeroization, which runs on DLL_PROCESS_DETACH inside ExitProcess, and
# aws-lc then aborts: R crashed on exit after any TLS use. At 0x0A00 it uses
# ProcessPrng, as MSVC builds do, which works there. Rust's Windows targets
# need Windows 10 anyway. https://github.com/mdsumner/windows-rust-tls-exit
AWSLC_CFLAGS = -D_WIN32_WINNT=0x0A00 $(AWS_LC_SYS_CFLAGS)

$(STATLIB):
	mkdir -p $(TARGET_DIR)/libgcc_mock
	touch $(TARGET_DIR)/libgcc_mock/libgcc_eh.a
	if [ -f ./rust/vendor.tar.xz ]; then \
		tar xf rust/vendor.tar.xz -C rust && \
		mkdir -p $(CARGOTMP) && \
		cp rust/vendor-config.toml $(CARGOTMP)/config.toml && \
		export CARGO_HOME=$(CARGOTMP); \
	fi; \
	export PATH="$(PATH):$(USERPROFILE)/.cargo/bin" && \
	export LIBRARY_PATH="$(LIBRARY_PATH);$(CURDIR)/$(TARGET_DIR)/libgcc_mock" && \
	export AWS_LC_SYS_CFLAGS="$(AWSLC_CFLAGS)" && \
	cargo build @OFFLINE@ --target=$(TARGET) --no-default-features --features @FEATURES@ --lib @PROFILE@ \
		--manifest-path=./rust/Cargo.toml --target-dir $(TARGET_DIR)

rust_clean: $(SHLIB)
	rm -Rf $(CARGOTMP) ./rust/vendor @CLEAN_TARGET@

clean:
	rm -Rf $(SHLIB) $(STATLIB) $(OBJECTS) $(TARGET_DIR)
